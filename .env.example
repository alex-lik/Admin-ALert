# Admin-ALert — конфигурация. Скопируй в .env и заполни.
# Секреты НЕ коммитить. В проде — только в менеджере секретов.

APP_NAME=Admin-ALert
ENVIRONMENT=dev
DEBUG=true

# Версия дублируется из корневого файла VERSION (её обновляет tools/release.py)
VERSION=0.1.0

# --- Хранилище ---
DATABASE_URL=postgresql+asyncpg://adminalert:CHANGE-ME@db:5432/adminalert
REDIS_URL=redis://redis:6379/0

# --- Аутентификация (обязательно сменить в проде) ---
JWT_SECRET=CHANGE-ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Воркер эскалации ---
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=100
HEARTBEAT_STALE_SECONDS=900

# --- Приём событий ---
EVENTS_RATE_LIMIT_PER_MINUTE=600

# --- Push (задачи 1.7, 2.16–2.18) ---
# Путь к JSON-ключу сервисного аккаунта Firebase. Пусто — FCM не настроен,
# и воркер честно пишет в аудите `skipped`, а не выдуманное `delivered`.
# Ключ в репозитории быть не должен.
# FCM_SERVICE_ACCOUNT_FILE=
# Переопределяет project_id из файла, если ключ от другого проекта.
# FCM_PROJECT_ID=

# Critical Alerts на iOS требуют entitlement от Apple. Без него FCM отвечает
# BadPriority и уведомление не доходит вовсе — поэтому по умолчанию выключено.
APNS_CRITICAL_ALERTS=false

# Ключ APNs для отправки в iOS (задача 1.8, 1.9). Пока не используется:
# iOS-устройства получают data-сообщение с apns-блоком, но подпись APNs
# требует отдельной реализации.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY_PATH=

# --- Telegram (задача 4.8) ---
# Токен от @BotFather. Секрет: даёт право писать от имени бота всем, кто его
# знает. В репозитории быть не должен.
TELEGRAM_BOT_TOKEN=
# Секрет для заголовка X-Telegram-Bot-Api-Secret-Token на webhook. Пусто —
# webhook открыт всем, кто знает адрес, и нажатие «Принял» можно подделать.
# Обязателен, если сервер доступен снаружи. Только ASCII (это HTTP-заголовок).
TELEGRAM_WEBHOOK_SECRET=

# --- Телефония (задача 1.12) ---
# AMI_HOST=
# AMI_PORT=5038
# AMI_USER=
# AMI_PASSWORD=
