# Admin-ALert — конфигурация. Скопируй в .env и заполни.
# Секреты НЕ коммитить. В проде — только в менеджере секретов.

APP_NAME=Admin-ALert
ENVIRONMENT=dev
DEBUG=true

# Версия дублируется из корневого файла VERSION (её обновляет tools/release.py)
VERSION=0.1.0

# --- Хранилище ---
DATABASE_URL=postgresql+asyncpg://adminalert:CHANGE-ME@db:5432/adminalert
REDIS_URL=redis://redis:6379/0

# --- Аутентификация (обязательно сменить в проде) ---
JWT_SECRET=CHANGE-ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- Воркер эскалации ---
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_BATCH_SIZE=100
HEARTBEAT_STALE_SECONDS=900

# --- Приём событий ---
EVENTS_RATE_LIMIT_PER_MINUTE=600

# --- Push (задачи 1.7, 1.8) ---
# Секрет из Firebase service account и .p8 от Apple. В репозитории их быть не должно.
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY_PATH=

# --- Телефония (задача 1.12) ---
# AMI_HOST=
# AMI_PORT=5038
# AMI_USER=
# AMI_PASSWORD=
